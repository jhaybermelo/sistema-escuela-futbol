# Dominio real solo se usa en producción (docker-compose.prod.yml + Caddyfile),
# para que Caddy pueda emitir el certificado HTTPS automáticamente.
DOMAIN=escuela.tudominio.com

POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=escuela_futbol

DATABASE_URL=postgresql+asyncpg://postgres:password@postgres-db:5432/escuela_futbol
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8
UPLOAD_DIR=uploads
LOG_DIR=logs
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
TIMEZONE=America/Bogota

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

CALLMEBOT_API_KEY=
